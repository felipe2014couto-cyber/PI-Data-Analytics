APP_NAME=PI Analytics Data
APP_ENV=development
APP_DEBUG=false
DATABASE_URL=postgresql+psycopg://pi_app@localhost:6543/pi_analytics
DATABASE_PASSWORD=replace-with-the-application-password
FRONTEND_ORIGIN=http://localhost:5173

# Autenticacao local. Defina um segredo aleatorio com pelo menos 32 caracteres.
AUTH_JWT_SECRET=
AUTH_JWT_EXPIRE_MINUTES=60
AUTH_COOKIE_SECURE=false

# PI Web API - valores de exemplo. NAO versionar credenciais reais.
PI_WEB_API_BASE_URL=
PI_WEB_API_AUTH_MODE=none
PI_WEB_API_USERNAME=
PI_WEB_API_PASSWORD=
PI_WEB_API_VERIFY_SSL=true
PI_DATA_SERVER_NAME=
PI_REQUEST_TIMEOUT_SECONDS=30
PI_REQUEST_MAX_RETRIES=2
PI_QUERY_MAX_TAGS=10
PI_QUERY_MAX_POINTS_PER_TAG=20000
PI_QUERY_VISUAL_DEFAULT_POINTS_PER_TAG=1500
PI_QUERY_VISUAL_MAX_TOTAL_POINTS=200000
TIMESCALEDB_DYNAMIC_RAW_POINT_LIMIT=5000
TIMESCALEDB_QUERY_CACHE_TTL_SECONDS=45
TIMESCALEDB_QUERY_CACHE_MAX_ENTRIES=64

# Ingestao live: RecordedValues e series interpoladas persistidas.
INGESTION_CYCLE_SECONDS=10
INGESTION_RECORDED_CYCLE_SECONDS=60
INGESTION_RECORDED_WINDOW_SECONDS=60
INGESTION_RECORDED_MAX_POINTS=20000
PI_QUERY_CONCURRENCY=1
PI_QUERY_GLOBAL_LOCK_KEY=2147483003
BACKFILL_ADMIN_CONCURRENCY=1
BACKFILL_LEASE_SECONDS=900
BACKFILL_HEARTBEAT_SECONDS=30
BACKFILL_RETRY_BASE_SECONDS=5
BACKFILL_RETRY_MAX_SECONDS=300
